// ユーザー情報
Table users {
  id varchar [primary key]
  name varchar [not null]
  email varchar [unique, not null]
  password_hash text [not null]
  icon_url text
  cover_url text
  one_word text
  role varchar
  tech_stack text
  twitter_url text
  github_url text
  portfolio_url text
  affiliation text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// イベント情報
Table events {
  id serial [primary key]
  name varchar [not null]
  location varchar
  start_at timestamp
  end_at timestamp
  created_at timestamp [default: `now()`]
}

// イベント参加者 (中間テーブル)
Table event_participants {
  id serial [primary key]
  event_id integer [ref: > events.id]
  user_id varchar [ref: > users.id]
  joined_at timestamp [default: `now()`]
}

// すれ違い記録
Table encounters {
  id serial [primary key]
  my_id varchar [ref: > users.id]
  target_id varchar [ref: > users.id]
  event_id integer [ref: > events.id, note: '任意']
  is_confirmed boolean [default: false]
  created_at timestamp [default: `now()`]
}